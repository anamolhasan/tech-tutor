{
  "name": "@tech-tutor/ui",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    }
  },
  "sideEffects": false,
  "scripts": {
    "check-types": "tsc --noEmit",
    "lint": "eslint . --max-warnings 0",
    "clean": "node -e \"require('fs').rmSync('.turbo',{recursive:true,force:true});require('fs').rmSync('dist',{recursive:true,force:true});require('fs').rmSync('node_modules',{recursive:true,force:true})\""
  },
  "dependencies": {
    "@tech-tutor/types": "workspace:*",
    "@tech-tutor/utils": "workspace:*"
  },
  "devDependencies": {
    "@tech-tutor/eslint-config": "workspace:*",
    "@tech-tutor/typescript-config": "workspace:*",
    "@types/react": "catalog:react19",
    "@types/react-dom": "catalog:react19",
    "eslint": "catalog:eslint9",
    "react": "catalog:react19",
    "react-dom": "catalog:react19",
    "typescript": "catalog:typescript5"
  },
  "peerDependencies": {
    "react": "^19.1.1",
    "react-dom": "^19.1.1"
  }
}